# Copie para .env e ajuste em produção
PORT=4000

# Modo de autenticação:
#   password -> login por e-mail/senha (bcrypt+JWT). Use localmente.
#   entra    -> confia no login Microsoft do Azure App Service (Entra ID).
#               USE SOMENTE atrás do "Easy Auth" com autenticação obrigatória.
AUTH_MODE=password

# Segredo para assinar os JWT — TROQUE em produção por um valor aleatório e longo
JWT_SECRET=troque-este-segredo-em-producao

# Senha padrão dos usuários semeados (usada apenas no modo password)
SEED_PASSWORD=ControlaAi@2026

# Origem permitida para CORS (só relevante se o frontend rodar em outra origem)
CLIENT_ORIGIN=http://localhost:5173

# Domínio de e-mail permitido no modo entra (defesa extra além do tenant)
ALLOWED_EMAIL_DOMAIN=exemplo.com.br

# Diretório do banco SQLite (no Azure use armazenamento persistente, ex.: /home/data)
# DB_DIR=/home/data

# Semear o banco automaticamente no primeiro start (ex.: 1º deploy no Azure)
# AUTO_SEED=true
